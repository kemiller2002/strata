<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier 4 - Host / External Effects (DF-STRATA-2026-D3F8).

    Reads SQL from disk. Separate from the parser and catalog adapters because
    the filesystem is its own effect boundary, and because keeping it testable
    on a temp directory is worth more than saving a project file.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Strata.Host.Files</AssemblyName>
    <RootNamespace>Strata.Host.Files</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FileCorpus.fs" />
    <Compile Include="Project.fs" />
    <Compile Include="RenameAnnotations.fs" />
    <Compile Include="Artifact.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Strata.Analysis/Strata.Analysis.fsproj" />
    <!--
      Tier 3, for the artifact's own type. Dependencies point downward: Tier 3
      never references a host adapter, so this direction is the legal one.
    -->
    <ProjectReference Include="../Strata.Application/Strata.Application.fsproj" />
  </ItemGroup>

</Project>
