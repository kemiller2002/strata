<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier 3 - Application / Orchestration (DF-STRATA-2026-D3F8).

    Coordinates use cases and projections. It must NOT become a second semantic
    authority: if this tier starts deciding what is legal or how certain a fact
    is, the Tier 1/2 boundary has failed. It composes; it does not re-decide.

    References Tier 1 and Tier 2 only. Host adapters are injected as functions
    so this tier performs no I/O itself.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Strata.Application</AssemblyName>
    <RootNamespace>Strata.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CorpusPipeline.fs" />
    <Compile Include="Retrieval.fs" />
    <Compile Include="DeploymentGate.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="DesiredState.fs" />
    <!--
      The schema diff, one responsibility per file (STRATA-QUAL-001). Compile
      order IS the dependency direction and is checked by
      SchemaDiffArchitectureTests: model, then the drop-safety policy, then the
      per-family differs, then ordering and PostgreSQL SQL (siblings), then
      orchestration, then rendering.
    -->
    <Compile Include="SchemaDiff/Resolved.fs" />
    <Compile Include="SchemaDiff/Model.fs" />
    <Compile Include="SchemaDiff/DropSafety.fs" />
    <Compile Include="SchemaDiff/Schemas.fs" />
    <Compile Include="SchemaDiff/Extensions.fs" />
    <Compile Include="SchemaDiff/RowSecurity.fs" />
    <Compile Include="SchemaDiff/Grants.fs" />
    <Compile Include="SchemaDiff/Comments.fs" />
    <Compile Include="SchemaDiff/Sequences.fs" />
    <Compile Include="SchemaDiff/Enums.fs" />
    <Compile Include="SchemaDiff/Domains.fs" />
    <Compile Include="SchemaDiff/Tables.fs" />
    <Compile Include="SchemaDiff/TableIndexes.fs" />
    <Compile Include="SchemaDiff/TableTriggers.fs" />
    <Compile Include="SchemaDiff/TableConstraints.fs" />
    <Compile Include="SchemaDiff/Objects.fs" />
    <Compile Include="SchemaDiff/ReferenceRows.fs" />
    <Compile Include="SchemaDiff/ObjectDependencies.fs" />
    <Compile Include="SchemaDiff/Ordering.fs" />
    <Compile Include="SchemaDiff/PostgresSql.fs" />
    <Compile Include="SchemaDiff/CommentSql.fs" />
    <Compile Include="SchemaDiff/PostgresDdl.fs" />
    <Compile Include="SchemaDiff/Plan.fs" />
    <Compile Include="SchemaDiff/Render.fs" />
    <Compile Include="Invariants.fs" />
    <Compile Include="ResolvedDesiredState.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Strata.Semantic/Strata.Semantic.fsproj" />
    <ProjectReference Include="../Strata.Analysis/Strata.Analysis.fsproj" />
  </ItemGroup>

</Project>
