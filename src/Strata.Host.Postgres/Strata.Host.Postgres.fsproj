<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier 4 - Host / External Effects (DF-STRATA-2026-D3F8).

    PostgreSQL catalog access. The ONLY project permitted to reference Npgsql.

    Reading is the default and the bulk of it: CatalogQueries holds nothing but
    SELECTs against pg_catalog (NFR-006, least privilege), and CatalogIntrospection
    issues nothing else.

    Three modules write, and each says so in its own header:
      * Execution          - applies an approved plan. The only durable writes
                             Strata makes, in one transaction.
      * ShadowNormalisation- creates declared DDL in a throwaway schema to learn
                             the server's rendering of it. Always rolled back.
      * ReferenceData      - the same trick for declared ROWS, and the only
                             place Strata reads table data rather than metadata.
                             Always rolled back.

    An earlier version of this comment claimed every statement here is a SELECT.
    That stopped being true when Execution arrived; it is corrected rather than
    quietly left, because a false claim about what touches a customer database
    is worse than no claim.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Strata.Host.Postgres</AssemblyName>
    <RootNamespace>Strata.Host.Postgres</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CatalogQueries.fs" />
    <Compile Include="CatalogIntrospection.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="ShadowNormalisation.fs" />
    <Compile Include="ReferenceData.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Strata.Semantic/Strata.Semantic.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

</Project>
