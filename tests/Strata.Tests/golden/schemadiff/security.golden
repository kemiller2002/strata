     | CREATE EXTENSION "citext"
[02] update-extension (UpdateExtension)
     | ALTER EXTENSION "pgcrypto" UPDATE TO '1.3'
[03] set-extension-schema (SetExtensionSchema)
     | ALTER EXTENSION "hstore" SET SCHEMA "sales"
[04] replace-policy (ReplacePolicy)
     | DROP POLICY "tenant_write" ON "sales"."orders";
     | CREATE POLICY tenant_write ON sales.orders FOR INSERT TO app_user WITH CHECK (tenant = 'x');
[05] create-policy (CreatePolicy)
     | CREATE POLICY new_policy ON sales.invoices FOR SELECT TO app_user USING (true);
