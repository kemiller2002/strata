<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>Strata.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ScopeResolutionTests.fs" />
    <Compile Include="AnalysisScopeTests.fs" />
    <Compile Include="ParserAdapterTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Strata.Semantic/Strata.Semantic.fsproj" />
    <ProjectReference Include="../../src/Strata.Analysis/Strata.Analysis.fsproj" />
    <ProjectReference Include="../../src/Strata.Host.PgParser/Strata.Host.PgParser.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
